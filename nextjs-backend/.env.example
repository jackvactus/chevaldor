# Copiez ce fichier en .env.local et renseignez les vraies valeurs (jamais commité).

# Connexion PostgreSQL (Neon ou autre) — inclure sslmode=require
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Secret de signature JWT — générez une valeur aléatoire longue (openssl rand -hex 32)
JWT_SECRET="changez-moi"

# Identifiants du compte admin créé par le seed (prisma/seed.ts) — optionnel, valeurs par défaut sinon
SEED_ADMIN_EMAIL="admin@chevaldor.com"
SEED_ADMIN_PASSWORD="Password1234@"
