# Peya Company ERP — variables d'environnement
# En Docker : généré automatiquement par ../deploy.sh

# Secret JWT (obligatoire en production)
PEYA_JWT_SECRET=changez-moi-en-production

# URL publique pour liens (e-mail, UI) — ex. http://192.168.1.10:8001
PEYA_PUBLIC_URL=
PEYA_PUBLIC_SCHEME=http
PEYA_SERVER_HOSTNAME=
PEYA_SERVER_IP=

# Écoute (Docker : 0.0.0.0)
PEYA_HOST=127.0.0.1
PEYA_PORT=8001
PEYA_RELOAD=1

# CORS (virgules) — complété auto avec hostname/IP si vide
PEYA_CORS_ORIGINS=http://127.0.0.1:8001,http://localhost:8001

# Données (Docker : /data)
PEYA_DATA_DIR=

# Taille max uploads (Mo)
PEYA_MAX_UPLOAD_MB=15
